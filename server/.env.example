# Core database — Neon in production; local PostgreSQL in development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/minara
# Optional reserved value for future read-heavy/pool-specific workloads.
DATABASE_POOL_URL=

# Redis-compatible production infrastructure (Render Key Value / Valkey).
# Leave blank locally to use Medusa's development-safe local providers. Enable the caching flag when Redis is configured.
REDIS_URL=
MEDUSA_FF_CACHING=false

# Browser origins. Comma-separated, no trailing slash.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Replace these in every shared/staging/production environment.
JWT_SECRET=change-me-local-jwt-secret
COOKIE_SECRET=change-me-local-cookie-secret

# Public API/Admin origin used by Medusa and file URLs.
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:3000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# Cloudinary — when all required fields are present the custom Medusa File provider is enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=minara
MEDIA_MAX_FILE_SIZE_MB=10
# Optional delivery base for Phase 1.1 seed images. If set, provide <product-handle>.webp assets at this Cloudinary path.
MINARA_SEED_MEDIA_BASE_URL=

# Resend — when key/from are present the real email provider is enabled.
# Keep REQUIRE_RESEND_IN_PRODUCTION=false for staging until the sending domain is ready;
# set it to true before final production launch so missing email credentials fail closed.
REQUIRE_RESEND_IN_PRODUCTION=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=MINARA NATURALS <orders@example.com>
RESEND_REPLY_TO=
# In non-production, optionally force every outbound message to one safe inbox.
RESEND_DEV_RECIPIENT=
RESEND_ENFORCE_DEV_RECIPIENT=true
TEST_EMAIL_TO=

# Allow deterministic demo seed in a non-development environment only when explicitly set.
ALLOW_DEMO_SEED=false

# Phase 1.7 — prepaid checkout. Leave disabled until the staging checklist passes.
CHECKOUT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Use test keys in staging. Configure the same values on the API and worker.
# Webhook: <MEDUSA_BACKEND_URL>/hooks/payment/razorpay_razorpay
# Events: payment.authorized, payment.captured. Use automatic capture in Razorpay.
# STOREFRONT_URL must be canonical and HTTPS in production; it is used in reset/order emails.
