{
  "name": "@minara/commerce-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MINARA NATURALS Medusa v2 commerce backend.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "build": "medusa build && cd .medusa/server && npm install --omit=dev --legacy-peer-deps",
    "dev": "medusa develop",
    "start": "cd .medusa/server && medusa start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "medusa db:migrate",
    "db:rollback": "medusa db:rollback",
    "admin:create": "medusa user",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "email:test": "medusa exec ./src/scripts/send-test-email.ts",
    "test": "npm run test:unit && npm run test:integration:http",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "lint": "medusa lint",
    "predeploy": "medusa db:migrate"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/admin-shared": "2.21.0",
    "@medusajs/caching": "2.21.0",
    "@medusajs/caching-redis": "2.21.0",
    "@medusajs/cli": "2.21.0",
    "@medusajs/dashboard": "2.21.0",
    "@medusajs/draft-order": "2.21.0",
    "@medusajs/framework": "2.21.0",
    "@medusajs/medusa": "2.21.0",
    "@medusajs/ui": "4.2.4",
    "@tanstack/react-query": "5.64.2",
    "ajv": "^8.20.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "resend": "^6.0.3",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.0",
    "@medusajs/test-utils": "2.21.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.6.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "7.3.6"
  }
}
